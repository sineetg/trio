# Required for production builds. Set this to the real canonical HTTPS origin, with no path.
NEXT_PUBLIC_SITE_URL=

# Optional. Analytics stays disabled until a GA4 measurement ID is supplied and a visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required for inquiry delivery. Keep RESEND_API_KEY server-only; do not prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional public contact details and verified social profiles.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
